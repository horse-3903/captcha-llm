# OpenRouter API key — required for live model evaluation (ASCII and audio pipelines)
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=

# OpenAI API key — optional, used by the direct OpenAI adapter (src/ascii-captcha/utils/openai.py)
OPENAI_API_KEY=

# Google API key — optional, for direct Gemini API access
GOOGLE_API_KEY=

# Anthropic API key — optional, for direct Anthropic API access
ANTHROPIC_API_KEY=

# HuggingFace token — optional, required only for src/deepseek-ocr/ model download
HUGGINGFACE_TOKEN=

# DeepSeek API key — optional, for direct DeepSeek API access
DEEPSEEK_API_KEY=
